{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-lab.local/schema/harness-case-v1.schema.json",
  "title": "OS Lab tutor harness case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "labId", "initialStage", "turns", "expected"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "labId": { "type": "string", "pattern": "^lab[1-8]$" },
    "initialStage": { "enum": ["orient", "read", "run", "debug", "reflect", "transfer"] },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["student", "evidence"],
        "properties": {
          "student": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "payload"],
              "properties": {
                "type": { "type": "string", "minLength": 1, "maxLength": 80 },
                "payload": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedStages", "requiredActions", "forbiddenPatterns"],
      "properties": {
        "allowedStages": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["orient", "read", "run", "debug", "reflect", "transfer"] }
        },
        "requiredActions": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
        "forbiddenPatterns": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
      }
    }
  }
}
