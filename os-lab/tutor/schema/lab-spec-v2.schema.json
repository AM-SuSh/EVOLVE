{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-lab.local/schema/lab-spec-v2.schema.json",
  "title": "EVOLVE teaching specification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "version",
    "feature",
    "prerequisites",
    "status",
    "manual",
    "answers",
    "tutor_context",
    "knowledge",
    "tasks",
    "starter_files",
    "variants",
    "verification",
    "misconceptions",
    "rubric_ref"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^lab[1-8]$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "feature": { "type": "string", "pattern": "^lab[1-8]$" },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^lab[1-8]$" }
    },
    "textbook": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["draft", "sample", "stable", "deprecated"] },
    "manual_revision": { "type": "string", "minLength": 1, "maxLength": 160 },
    "manual": { "$ref": "#/$defs/path" },
    "answers": { "$ref": "#/$defs/path" },
    "tutor_context": { "$ref": "#/$defs/path" },
    "knowledge": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "concept_ref"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "level": { "enum": ["concept", "mechanism", "implementation", "practice", "evidence", "transfer"] },
          "concept_ref": { "$ref": "#/$defs/path" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "goal"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "stage": { "enum": ["orient", "read", "run", "debug", "reflect"] },
          "goal": { "type": "string", "minLength": 1 }
        }
      }
    },
    "starter_files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "editable_by_variant", "generated"],
      "properties": {
        "added": { "$ref": "#/$defs/paths" },
        "editable_by_variant": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/paths" }
        },
        "generated": { "$ref": "#/$defs/paths" }
      }
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest", "source"],
        "properties": {
          "manifest": { "$ref": "#/$defs/path" },
          "source": { "$ref": "#/$defs/path" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "command", "assertions", "observable_trace"],
      "properties": {
        "recipe": { "type": "string", "pattern": "^lab[1-8]\\.[A-Za-z0-9.-]+\\.v[0-9]+$" },
        "command": { "type": "string", "minLength": 1 },
        "command_with_trace": { "type": "string", "minLength": 1 },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
        "negative_assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
        "observable_trace": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["trap_enter", "task_switch", "syscall", "address_space"] }
        }
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "counter"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 1 },
          "counter": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rubric_ref": { "$ref": "#/$defs/path" },
    "mock_traces_ref": { "$ref": "#/$defs/path" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 500 },
    "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["output-contains", "output-count", "trace-present"] },
        "text": { "type": "string", "minLength": 1 },
        "min": { "type": "integer", "minimum": 1 },
        "assesses": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
